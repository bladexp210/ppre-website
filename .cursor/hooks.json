{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-shell.sh",
        "timeout": 15,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/verify-stop.sh",
        "loop_limit": 2,
        "timeout": 120,
        "failClosed": false
      }
    ]
  }
}
